root = true

[*]
# BOM 없음. 셰이더는 D3DCompileFromFile 이 BOM 을 거부하고(X3000), C++ 은 /utf-8 로 읽는다
charset = utf-8

[*.{h,cpp,hlsl,vs,ps,rc,sln,vcxproj,vcxproj.filters}]
end_of_line = crlf

[{*.sh,*.cmake,CMakeLists.txt,*.md,*.json,*.xml,*.manifest}]
end_of_line = lf

[*.DotSettings]
# Rider 가 저장할 때마다 BOM 을 붙인다
charset = utf-8-bom
end_of_line = lf
